<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x86</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>build\AppManifest.xml</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NTwain" Version="3.7.6" />
    <PackageReference Include="PdfSharpCore" Version="1.3.65" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\SpeedScanManager_Logo.png" LogicalName="SpeedScanManager_Logo.png" />
    <EmbeddedResource Include="assets\SpeedScanManager_Text.png" LogicalName="SpeedScanManager_Text.png" />
  </ItemGroup>

  <Target Name="UnblockPublishedFile" AfterTargets="Publish">
    <Exec Condition="'$([System.OperatingSystem]::IsWindows())' == 'true'"
          Command="powershell -NoProfile -Command &quot;Get-ChildItem -Path '$(PublishDir)' -Recurse -File | Unblock-File&quot;" />
  </Target>

  <Target Name="SignPublishedFile" AfterTargets="UnblockPublishedFile" Condition="'$([System.OperatingSystem]::IsWindows())' == 'true' And Exists('$(MSBuildThisFileDirectory)build\cert\SpeedScan.pfx')">
    <Exec Command="powershell -NoProfile -Command &quot;$sdkPath = '$(ProgramFiles)\Windows Kits\10\bin'; if (-not (Test-Path $sdkPath)) { Write-Warning 'Windows SDK not found, skipping code signing'; exit 0 }; $sdks = Get-ChildItem $sdkPath -Directory | Sort-Object Name -Descending; if ($sdks.Count -eq 0) { Write-Warning 'No Windows SDK versions found, skipping code signing'; exit 0 }; $tool = Join-Path $sdks[0].FullName 'x86\signtool.exe'; if (-not (Test-Path $tool)) { Write-Warning 'signtool.exe not found, skipping code signing'; exit 0 }; &amp; $tool sign /f '$(MSBuildThisFileDirectory)build\cert\SpeedScan.pfx' /p SpeedScan2026 /t http://timestamp.digicert.com /fd SHA256 '$(PublishDir)SpeedScanManager.exe'&quot;" />
  </Target>

</Project>
