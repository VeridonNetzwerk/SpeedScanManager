<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <AssemblyName>SpeedScanInstaller</AssemblyName>
    <RootNamespace>SpeedScanInstaller</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\SpeedScanManager.ico</ApplicationIcon>
    <Company>VeridonNetzwerk</Company>
    <Product>SpeedScan Manager Installer</Product>
    <Copyright>Copyright © 2024 VeridonNetzwerk</Copyright>
    <Description>Installer for SpeedScan Manager document scanning application</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\assets\SpeedScanManager_Text_2Rows.png" Link="Assets\SpeedScanManager_Text_2Rows.png" />
    <Resource Include="..\assets\SpeedScanManager_Text.png" Link="Assets\SpeedScanManager_Text.png" />
    <Resource Include="..\assets\SpeedScanManager_Logo.png" Link="Assets\SpeedScanManager_Logo.png" />
  </ItemGroup>

</Project>
