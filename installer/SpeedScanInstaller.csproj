<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Overridden by build-release.ps1 / CI with -p:Version=<SpeedScanManager.csproj Version> -->
    <Version>0.2.0</Version>
    <AssemblyName>SpeedScanInstaller</AssemblyName>
    <RootNamespace>SpeedScanInstaller</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\SpeedScanManager.ico</ApplicationIcon>
    <Company>VeridonNetzwerk</Company>
    <Product>SpeedScan Manager Installer</Product>
    <Copyright>Copyright © 2026 VeridonNetzwerk</Copyright>
    <Description>Installer for SpeedScan Manager document scanning application</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\assets\SpeedScanManager_Text_2Rows.png" Link="Assets\SpeedScanManager_Text_2Rows.png" />
    <Resource Include="..\assets\SpeedScanManager_Text.png" Link="Assets\SpeedScanManager_Text.png" />
    <Resource Include="..\assets\SpeedScanManager_Logo.png" Link="Assets\SpeedScanManager_Logo.png" />
    <!-- Translations: lang/<code>.json (German text -> translation), see I18n.cs -->
    <EmbeddedResource Include="lang\*.json" LogicalName="lang.%(Filename).json" />
    <!-- Flags of the language picker (rendered from the app's ColorIcons.DrawFlag) -->
    <Resource Include="lang\flags\*.png" />
  </ItemGroup>

  <!--
    App payload: the published SpeedScanManager (zipped) is embedded into the installer.
    build-release.ps1 / CI pass -p:AppPayloadZip=<path to zip>. Without it (plain dev build)
    the installer falls back to a "dist" folder next to the exe or the repo's dist folder.
  -->
  <ItemGroup Condition="'$(AppPayloadZip)' != '' And Exists('$(AppPayloadZip)')">
    <EmbeddedResource Include="$(AppPayloadZip)" LogicalName="AppPayload.zip" Link="Payload\AppPayload.zip" />
  </ItemGroup>

  <!--
    Uninstaller: a build of this project WITHOUT payload (first publish step in
    build-release.ps1), passed as -p:UninstallerExe=<path>. The setup installs it as
    uninstall.exe, so the uninstaller doesn't carry the app payload. Without it (dev build)
    the setup copies itself.
  -->
  <ItemGroup Condition="'$(UninstallerExe)' != '' And Exists('$(UninstallerExe)')">
    <EmbeddedResource Include="$(UninstallerExe)" LogicalName="Uninstaller.exe" Link="Payload\Uninstaller.exe" />
  </ItemGroup>

  <Target Name="ReportAppPayload" BeforeTargets="CoreCompile">
    <Error Condition="'$(AppPayloadZip)' != '' And !Exists('$(AppPayloadZip)')" Text="AppPayloadZip not found: $(AppPayloadZip)" />
    <Error Condition="'$(UninstallerExe)' != '' And !Exists('$(UninstallerExe)')" Text="UninstallerExe not found: $(UninstallerExe)" />
    <Message Importance="high" Condition="'$(AppPayloadZip)' != ''" Text="SpeedScanInstaller: embedding app payload $(AppPayloadZip)" />
    <Message Importance="high" Condition="'$(AppPayloadZip)' == ''" Text="SpeedScanInstaller: no app payload embedded (dev build, uses dist folder)" />
    <Message Importance="high" Condition="'$(UninstallerExe)' != ''" Text="SpeedScanInstaller: embedding uninstaller $(UninstallerExe)" />
  </Target>

</Project>
