<Window x:Class="SpeedScanInstaller.ReadmeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="README – SpeedScan Manager"
        Height="600" Width="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        MinWidth="500" MinHeight="400">

    <Border CornerRadius="8" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="#1c2633">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="README – SpeedScan Manager"
                           Foreground="White" FontFamily="Segoe UI" FontSize="13"
                           FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="16,0,0,0"/>
                <Button Grid.Column="1" x:Name="BtnClose"
                        Width="36" Height="28"
                        Click="OnCloseClick"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Margin="0,0,4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="0,8,0,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#c0392b"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="White"/>
                </Button>
                <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Fill="Transparent"
                           MouseLeftButtonDown="OnDragMove"/>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1">
                <!-- Loading indicator -->
                <StackPanel x:Name="LoadingPanel"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Lade README..." FontFamily="Segoe UI" FontSize="14"
                               Foreground="#555555" HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="LoadingBar" IsIndeterminate="True"
                                 Width="240" Height="4" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- Error -->
                <TextBlock x:Name="ErrorText" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"
                           FontFamily="Segoe UI" FontSize="13" Foreground="#c0392b"
                           Margin="32,0,32,0"/>

                <!-- WebBrowser for rendered HTML -->
                <WebBrowser x:Name="Browser" Visibility="Collapsed"
                            Margin="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
