<Window x:Class="SpeedScanInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:WPF="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SpeedScan Manager Setup"
        Height="540" Width="800"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        ShowInTaskbar="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- ===== TITLE BAR ===== -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnDragMove">
                <Grid Margin="14,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource SidebarBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Image Source="pack://application:,,,/SpeedScanInstaller;component/Assets/SpeedScanManager_Logo.png"
                                   Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Setup" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="SpeedScan Manager" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ToggleButton x:Name="BtnTheme" Style="{StaticResource ThemeSwitch}"
                                      ToolTip="{DynamicResource ThemeToggleTip}"
                                      Click="OnThemeClick"/>
                        <Button x:Name="BtnMinimize" Style="{StaticResource TitleButton}" Content="&#xE921;"
                                ToolTip="Minimieren" Click="OnMinimizeClick"/>
                        <Button x:Name="BtnClose" Style="{StaticResource CloseTitleButton}" Content="&#xE8BB;"
                                ToolTip="Schließen" Click="OnExitClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== BODY ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== SIDEBAR ===== -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
                    <Grid Margin="10,18,10,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="SPEEDSCAN MANAGER" Style="{StaticResource SectionLabel}"/>

                            <RadioButton x:Name="BtnInstall" Style="{StaticResource NavItem}" IsChecked="True"
                                         Click="OnInstallClick">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource IconTile}" Background="#3B82F6">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource TileGlyph}"/>
                                    </Border>
                                    <TextBlock Text="Installieren" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="BtnReadme" Style="{StaticResource NavItem}" Click="OnReadmeClick">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource IconTile}" Background="#F59E0B">
                                        <TextBlock Text="&#xE736;" Style="{StaticResource TileGlyph}"/>
                                    </Border>
                                    <TextBlock Text="README" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="BtnSupport" Style="{StaticResource NavItem}" Click="OnSupportClick">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource IconTile}" Background="#EC4899">
                                        <TextBlock Text="&#xE8F2;" Style="{StaticResource TileGlyph}"/>
                                    </Border>
                                    <TextBlock Text="Support" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <TextBlock Grid.Row="2" x:Name="LblVersion" Text="" FontSize="11" Margin="12,0,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </Grid>
                </Border>

                <!-- ===== CONTENT ===== -->
                <Border Grid.Column="1" Background="{DynamicResource ContentBrush}">
                    <Grid>

                        <!-- ===== WELCOME / INSTALL VIEW ===== -->
                        <Grid x:Name="WelcomeView" Margin="28,22,28,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="WelcomeTitle" Text="Willkommen" Style="{StaticResource PageTitle}"/>
                                    <TextBlock x:Name="WelcomeSubtitle" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                                               Text="Richtet SpeedScan Manager auf diesem Computer ein."/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnUninstallExisting" Style="{StaticResource SecondaryButton}"
                                        Visibility="Collapsed" VerticalAlignment="Center" Margin="12,0,0,0" Click="OnUninstallExistingClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource ButtonGlyph}"/>
                                        <TextBlock Text="Deinstallieren"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Target folder -->
                            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource BigIconTile}" Background="#F97316">
                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource BigTileGlyph}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="Zielordner" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="Hier werden die Programmdateien abgelegt."
                                                   Style="{StaticResource CardText}" Margin="0,2,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtInstallPath" Style="{StaticResource PathBox}"/>
                                            <Button Grid.Column="1" x:Name="BtnBrowse" Style="{StaticResource SecondaryButton}"
                                                    Margin="8,0,0,0" Padding="14,0" Click="OnBrowseClick">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8DA;" Style="{StaticResource ButtonGlyph}"/>
                                                    <TextBlock Text="Durchsuchen..."/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Options -->
                            <Border Grid.Row="2" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource BigIconTile}" Background="#8B5CF6">
                                        <TextBlock Text="&#xE713;" Style="{StaticResource BigTileGlyph}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="Optionen" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="ChkDesktop" Style="{StaticResource FlatCheckBox}" IsChecked="True"
                                                  Content="Verknüpfung auf dem Desktop" Margin="0,0,0,8"/>
                                        <CheckBox x:Name="ChkStartMenu" Style="{StaticResource FlatCheckBox}" IsChecked="True"
                                                  Content="Eintrag im Startmenü"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Progress + install button -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed"
                                            VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock x:Name="StatusText" Text="" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,7"/>
                                    <ProgressBar x:Name="InstallProgress" Style="{StaticResource FlatProgress}"
                                                 Minimum="0" Maximum="100" Value="0"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnStartInstall" Style="{StaticResource AccentButton}"
                                        Content="Installieren" MinWidth="140" Click="OnStartInstallClick"/>
                            </Grid>
                        </Grid>

                        <!-- ===== FINISH VIEW ===== -->
                        <Grid x:Name="FinishView" Visibility="Collapsed" Margin="28,22,28,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="FinishBanner" Style="{StaticResource SuccessBanner}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid x:Name="FinishCheck" Width="50" Height="50">
                                                <Ellipse Fill="#33FFFFFF"/>
                                                <Ellipse Margin="6" Fill="White"/>
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="19" FontWeight="Bold" Foreground="#16A34A"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="Installation abgeschlossen" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="SpeedScan Manager ist bereit zum Scannen." FontSize="13" Foreground="#E6FFFFFF" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Width="52" Height="52" CornerRadius="14" Background="#26FFFFFF" VerticalAlignment="Center">
                                                <Image Source="pack://application:,,,/SpeedScanInstaller;component/Assets/SpeedScanManager_Logo.png" Width="34" Height="34"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                            <Border x:Name="FinishSummary" Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,10,8,8">
                                <StackPanel>
                                    <TextBlock Text="EINGERICHTET" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                                    <UniformGrid x:Name="FinishChecks" Columns="2"/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="3" Margin="0,10,0,0" VerticalAlignment="Top">
                                <Border x:Name="FinishWarning" Style="{StaticResource Card}" Visibility="Collapsed">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource BigIconTile}" Background="#F59E0B">
                                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource BigTileGlyph}"/>
                                                </Border>
                                                <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto">
                                                    <StackPanel>
                                                        <TextBlock Text="Bitte beachten" Style="{StaticResource CardTitle}"/>
                                                        <TextBlock x:Name="FinishWarningText" Style="{StaticResource CardText}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                            </Grid>

                            <Grid x:Name="FinishFooter" Grid.Row="4" Margin="0,12,0,0">
                                <CheckBox x:Name="ChkLaunch" Style="{StaticResource FlatCheckBox}" IsChecked="True"
                                          Content="SpeedScan Manager jetzt starten" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Right" MinWidth="140" Click="OnFinishClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource ButtonGlyph}"/>
                                        <TextBlock Text="Fertig"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>

                        <!-- ===== README VIEW ===== -->
                        <Grid x:Name="ReadmeView" Visibility="Collapsed">
                            <!-- WebView2 for rendered HTML (Chromium engine: color emoji, images, CSS, SVG) -->
                            <WPF:WebView2 x:Name="ReadmeBrowser"/>

                            <Border x:Name="ReadmeLoadingPanel" Background="{DynamicResource ContentBrush}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="README wird geladen..." FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    <ProgressBar IsIndeterminate="True" Width="220" Height="4" Margin="0,12,0,0"
                                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource TrackBrush}"
                                                 BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="ReadmeErrorText" Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       FontSize="13" Foreground="{DynamicResource DangerBrush}"
                                       Margin="32,0,32,0"/>
                        </Grid>

                        <!-- ===== SUPPORT VIEW ===== -->
                        <StackPanel x:Name="SupportView" Visibility="Collapsed" Margin="28,22,28,20">
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="Support &amp; Hilfe" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Wir sind für dich da." Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource BigIconTile}" Background="#E5484D">
                                        <TextBlock Text="&#xEBE8;" Style="{StaticResource BigTileGlyph}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="Bug gefunden?" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="Issue auf GitHub mit Scannermodell und Fehlerbeschreibung erstellen."
                                                   Style="{StaticResource CardText}" Margin="0,2,0,6"/>
                                        <TextBlock Text="GitHub Issue melden →" Style="{StaticResource Link}"
                                                   HorizontalAlignment="Left" MouseLeftButtonDown="OnGitHubIssueClick"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource BigIconTile}" Background="#F59E0B">
                                        <TextBlock Text="&#xE82F;" Style="{StaticResource BigTileGlyph}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="Verbesserungsidee?" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="Ideen und Vorschläge auf Discord teilen."
                                                   Style="{StaticResource CardText}" Margin="0,2,0,6"/>
                                        <TextBlock Text="Discord Feedback →" Style="{StaticResource Link}"
                                                   HorizontalAlignment="Left" MouseLeftButtonDown="OnDiscordFeedbackClick"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource BigIconTile}" Background="#6366F1">
                                        <TextBlock Text="&#xE897;" Style="{StaticResource BigTileGlyph}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="Hilfe benötigt?" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="Im Discord-FAQ findest du Antworten auf häufige Fragen."
                                                   Style="{StaticResource CardText}" Margin="0,2,0,6"/>
                                        <TextBlock Text="Discord FAQ →" Style="{StaticResource Link}"
                                                   HorizontalAlignment="Left" MouseLeftButtonDown="OnDiscordFaqClick"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                    </Grid>
                </Border>
            </Grid>

            <!-- ===== FOOTER ===== -->
            <Border Grid.Row="2" Background="{DynamicResource FooterBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Rectangle Fill="Transparent" MouseLeftButtonDown="OnDragMove"/>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="© 2026 VeridonNetzwerk" Style="{StaticResource FooterText}"/>
                        <TextBlock Text="·" Style="{StaticResource FooterText}" Margin="6,0"/>
                        <TextBlock Text="GPL-3.0 License" Style="{StaticResource FooterLink}"
                                   MouseLeftButtonDown="OnLicenseLinkClick"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0">
                        <TextBlock x:Name="LnkDiscord" Text="Discord" Style="{StaticResource FooterLink}"
                                   Margin="0,0,16,0" MouseLeftButtonDown="OnDiscordLinkClick"/>
                        <TextBlock x:Name="LnkGitHub" Text="GitHub" Style="{StaticResource FooterLink}"
                                   MouseLeftButtonDown="OnGitHubLinkClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
