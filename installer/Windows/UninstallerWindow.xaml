<Window x:Class="SpeedScanInstaller.UninstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpeedScan Manager Deinstallation"
        Height="450" Width="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="White"
        ShowInTaskbar="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="8"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2b3a4d" Offset="0"/>
            <GradientStop Color="#1c2633" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ContentBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ffffff" Offset="0"/>
            <GradientStop Color="#f0f2f5" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="FooterBrush" Color="#e8eaed"/>

        <ControlTemplate x:Key="UninstallButtonTemplate" TargetType="Button">
            <Border x:Name="bd"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="#c0392b"
                    Padding="0">
                <Border.Background>
                    <LinearGradientBrush x:Name="btnBg" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#e74c3c" Offset="0"/>
                        <GradientStop Color="#c0392b" Offset="0.5"/>
                        <GradientStop Color="#a93226" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.3" Direction="270"/>
                </Border.Effect>
                <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextBlock.Foreground="White" TextBlock.FontFamily="Segoe UI"
                                  TextBlock.FontSize="13" TextBlock.FontWeight="SemiBold"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#ec7063" Offset="0"/>
                                <GradientStop Color="#cd5b4a" Offset="0.5"/>
                                <GradientStop Color="#b03a2e" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#c0392b" Offset="0"/>
                                <GradientStop Color="#a93226" Offset="0.5"/>
                                <GradientStop Color="#922b21" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="cp" Property="Opacity" Value="0.4"/>
                    <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="InlineButtonTemplate" TargetType="Button">
            <Border x:Name="bd"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="#a0b0c0"
                    Padding="10,0"
                    Height="28">
                <Border.Background>
                    <LinearGradientBrush x:Name="btnBg" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#f5f7fa" Offset="0"/>
                        <GradientStop Color="#e8edf3" Offset="0.5"/>
                        <GradientStop Color="#d8dfe8" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextBlock.Foreground="#1c2633" TextBlock.FontFamily="Segoe UI"
                                  TextBlock.FontSize="12" TextBlock.FontWeight="Normal"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#eef4fc" Offset="0"/>
                                <GradientStop Color="#d8e4f4" Offset="0.5"/>
                                <GradientStop Color="#c4d4e8" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="bd" Property="BorderBrush" Value="#8aa0c0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#d0dce8" Offset="0"/>
                                <GradientStop Color="#bccce0" Offset="0.5"/>
                                <GradientStop Color="#a8bcd4" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="cp" Property="Opacity" Value="0.4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <!-- ===== Outer border with rounded corners ===== -->
    <Border CornerRadius="8" Background="White" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <!-- ===== Top drag bar ===== -->
            <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                       Height="15" VerticalAlignment="Top"
                       Fill="Transparent"
                       MouseLeftButtonDown="OnDragMove"
                       Panel.ZIndex="100"/>

            <!-- ===== Minimize button ===== -->
            <Button Grid.Row="0" Grid.Column="1"
                    x:Name="BtnMinimize"
                    Width="28" Height="18"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,0,2,0"
                    Panel.ZIndex="101"
                    Click="OnMinimizeClick"
                    Background="Transparent" BorderThickness="0"
                    Cursor="Hand">
                <TextBlock Text="&#xE949;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                           Foreground="#666666"/>
            </Button>

            <!-- ===== SIDEBAR ===== -->
            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SidebarBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Grid.Row="0" Margin="20,24,20,20">
                        <Image Source="pack://application:,,,/Assets/SpeedScanManager_Text_2Rows.png"
                               Width="150" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </StackPanel>

                    <!-- Info text -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="20,0,20,20">
                        <TextBlock Text="Deinstallation" FontFamily="Segoe UI" FontSize="14"
                                   FontWeight="SemiBold" Foreground="#a0b0c0"/>
                        <TextBlock Text="Entferne SpeedScan Manager von deinem System."
                                   FontFamily="Segoe UI" FontSize="11"
                                   Foreground="#708090" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Footer info -->
                    <StackPanel Grid.Row="2" Margin="20,0,20,16">
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== CONTENT AREA ===== -->
            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource ContentBrush}">
                <Grid Margin="32,24,32,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="SpeedScan Manager"
                                   FontFamily="Segoe UI" FontSize="24" FontWeight="SemiBold"
                                   Foreground="#1c2633"/>
                        <TextBlock Text="deinstallieren"
                                   FontFamily="Segoe UI" FontSize="24" FontWeight="SemiBold"
                                   Foreground="#c0392b" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Description -->
                    <TextBlock Grid.Row="1" TextWrapping="Wrap"
                               Text="Klicke auf &quot;Deinstallieren&quot;, um SpeedScan Manager von deinem Computer zu entfernen."
                               FontFamily="Segoe UI" FontSize="13"
                               Foreground="#555555" Margin="0,0,0,20"/>

                    <!-- Options -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Top">
                        <CheckBox x:Name="ChkRemoveSettings"
                                  Content="Alle Einstellungen und Profildaten mit löschen"
                                  FontFamily="Segoe UI" FontSize="13"
                                  Foreground="#333333" Margin="0,0,0,8"
                                  Cursor="Hand"/>
                        <TextBlock Text="Dies entfernt auch gespeicherte Scan-Profile und Anwendungseinstellungen aus %AppData%."
                                   FontFamily="Segoe UI" FontSize="11"
                                   Foreground="#888888" TextWrapping="Wrap" Margin="28,0,0,0"/>

                        <!-- Feedback card -->
                        <Border Background="#f8f9fb" CornerRadius="6" Padding="16,12" Margin="0,20,0,0"
                                BorderBrush="#e0e4e8" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="#f39c12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Wie können wir uns verbessern?" FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                                               Foreground="#1c2633" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Teile uns deine Ideen und Vorschläge auf Discord mit."
                                           FontFamily="Segoe UI" FontSize="12" Foreground="#555555" TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="Discord Feedback →" FontFamily="Segoe UI" FontSize="12"
                                           Foreground="#5865f2" Cursor="Hand"
                                           MouseLeftButtonDown="OnDiscordFeedbackClick"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Progress + status (hidden initially) -->
                    <StackPanel Grid.Row="2" x:Name="ProgressPanel" Visibility="Collapsed"
                                VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <ProgressBar x:Name="UninstallProgress" Height="22" Width="340"
                                     Minimum="0" Maximum="100" Value="0"/>
                        <TextBlock x:Name="StatusText" Text="" FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#555555" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button x:Name="BtnCancel"
                                Template="{StaticResource InlineButtonTemplate}"
                                Content="Abbrechen"
                                Margin="0,0,8,0"
                                Click="OnCancelClick"/>
                        <Button x:Name="BtnUninstall"
                                Template="{StaticResource UninstallButtonTemplate}"
                                Content="Deinstallieren"
                                Width="130" Height="36"
                                Click="OnUninstallClick"/>
                    </StackPanel>

                    <!-- ===== Confirm overlay (hidden initially) ===== -->
                    <Border x:Name="ConfirmOverlay" Grid.RowSpan="4"
                            Background="#E8FFFFFF" Visibility="Collapsed">
                        <Border Background="White" CornerRadius="8" Padding="24,20"
                                BorderBrush="#d0d4d8" BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="360">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.2" Direction="270"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                               Foreground="#e74c3c" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="Deinstallation bestätigen" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold"
                                               Foreground="#1c2633" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Möchtest du SpeedScan Manager wirklich deinstallieren?"
                                           FontFamily="Segoe UI" FontSize="13" Foreground="#555555"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Template="{StaticResource InlineButtonTemplate}"
                                            Content="Abbrechen"
                                            Margin="0,0,12,0"
                                            Click="OnConfirmCancelClick"/>
                                    <Button Template="{StaticResource UninstallButtonTemplate}"
                                            Content="Ja, deinstallieren"
                                            Width="150" Height="36"
                                            Click="OnConfirmUninstallClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== FOOTER BAR ===== -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Background="{StaticResource FooterBrush}"
                    BorderBrush="#d0d4d8" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="© 2026 VeridonNetzwerk" FontFamily="Segoe UI" FontSize="10"
                                   Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="·" FontFamily="Segoe UI" FontSize="10"
                                   Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="GPL-3.0 License" FontFamily="Segoe UI" FontSize="10"
                                   Foreground="#5566aa" Cursor="Hand" VerticalAlignment="Center"
                                   MouseLeftButtonDown="OnLicenseLinkClick"/>
                    </StackPanel>

                    <Rectangle Fill="Transparent" Panel.ZIndex="-1"
                               MouseLeftButtonDown="OnDragMove"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Discord" FontFamily="Segoe UI" FontSize="10"
                                   Foreground="#5566aa" Cursor="Hand" VerticalAlignment="Center"
                                   Margin="0,0,16,0"
                                   MouseLeftButtonDown="OnDiscordLinkClick"/>
                        <TextBlock Text="GitHub" FontFamily="Segoe UI" FontSize="10"
                                   Foreground="#5566aa" Cursor="Hand" VerticalAlignment="Center"
                                   MouseLeftButtonDown="OnGitHubLinkClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
