<Window x:Class="SpeedScanInstaller.UninstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpeedScan Manager Deinstallation"
        Height="500" Width="620"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        ShowInTaskbar="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- ===== TITLE BAR ===== -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnDragMove">
                <Grid Margin="14,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource SidebarBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Image Source="pack://application:,,,/SpeedScanInstaller;component/Assets/SpeedScanManager_Logo.png"
                                   Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Deinstallation" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="SpeedScan Manager" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ToggleButton x:Name="BtnTheme" Style="{StaticResource ThemeSwitch}"
                                      ToolTip="{DynamicResource ThemeToggleTip}"
                                      Click="OnThemeClick"/>
                        <Button x:Name="BtnMinimize" Style="{StaticResource TitleButton}" Content="&#xE921;"
                                ToolTip="Minimieren" Click="OnMinimizeClick"/>
                        <Button x:Name="BtnClose" Style="{StaticResource CloseTitleButton}" Content="&#xE8BB;"
                                ToolTip="Schließen" Click="OnCancelClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== CONTENT ===== -->
            <Grid Grid.Row="1" Background="{DynamicResource ContentBrush}">
                <!-- ===== FINISH VIEW ===== -->
                <Grid x:Name="FinishView" Visibility="Collapsed" Margin="28,22,28,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="FinishBanner" Style="{StaticResource SuccessBanner}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid x:Name="FinishCheck" Width="50" Height="50">
                                        <Ellipse Fill="#33FFFFFF"/>
                                        <Ellipse Margin="6" Fill="White"/>
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="19" FontWeight="Bold" Foreground="#16A34A"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="Deinstallation abgeschlossen" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="SpeedScan Manager wurde von diesem Computer entfernt." FontSize="13" Foreground="#E6FFFFFF" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                    <Border x:Name="FinishSummary" Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,10,8,8">
                        <StackPanel>
                            <TextBlock Text="ERLEDIGT" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                            <UniformGrid x:Name="FinishChecks" Columns="2"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Top">
                        <Border x:Name="FinishFeedback" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource BigIconTile}" Background="#5865F2" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8BD;" Style="{StaticResource BigTileGlyph}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Danke fürs Ausprobieren!" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Sag uns auf Discord, was wir besser machen können." Style="{StaticResource CardText}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Click="OnFeedbackButtonClick" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8BD;" Style="{StaticResource ButtonGlyph}"/>
                                        <TextBlock Text="Feedback"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <Border x:Name="FinishWarning" Style="{StaticResource Card}" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource BigIconTile}" Background="#F59E0B">
                                            <TextBlock Text="&#xE7BA;" Style="{StaticResource BigTileGlyph}"/>
                                        </Border>
                                        <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <TextBlock Text="Bitte beachten" Style="{StaticResource CardTitle}"/>
                                                <TextBlock x:Name="FinishWarningText" Style="{StaticResource CardText}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                    </Grid>

                    <Button Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource AccentButton}" HorizontalAlignment="Right"
                            MinWidth="140" Click="OnCancelClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource ButtonGlyph}"/>
                            <TextBlock Text="Schließen"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid x:Name="MainView" Margin="28,22,28,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="SpeedScan Manager deinstallieren" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Entfernt das Programm, die Verknüpfungen und die Scan-Tasten-Registrierung."/>
                    </StackPanel>

                    <!-- Options -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource BigIconTile}" Background="#64748B">
                                <TextBlock Text="&#xE713;" Style="{StaticResource BigTileGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Text="Einstellungen" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Gespeicherte Scan-Profile und Programmeinstellungen liegen in %AppData%."
                                           Style="{StaticResource CardText}" Margin="0,2,0,10"/>
                                <CheckBox x:Name="ChkRemoveSettings" Style="{StaticResource FlatCheckBox}"
                                          Content="Einstellungen und Profile ebenfalls löschen"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Feedback -->
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource BigIconTile}" Background="#F59E0B">
                                <TextBlock Text="&#xE82F;" Style="{StaticResource BigTileGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Text="Wie können wir uns verbessern?" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Teile uns deine Ideen und Vorschläge auf Discord mit."
                                           Style="{StaticResource CardText}" Margin="0,2,0,6"/>
                                <TextBlock Text="Discord Feedback →" Style="{StaticResource Link}"
                                           HorizontalAlignment="Left" MouseLeftButtonDown="OnDiscordFeedbackClick"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Progress + buttons -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed"
                                    VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock x:Name="StatusText" Text="" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,7"/>
                            <ProgressBar x:Name="UninstallProgress" Style="{StaticResource FlatProgress}"
                                         Minimum="0" Maximum="100" Value="0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnCancel" Style="{StaticResource SecondaryButton}"
                                    Content="Abbrechen" Margin="0,0,8,0" Click="OnCancelClick"/>
                            <Button x:Name="BtnUninstall" Style="{StaticResource DangerButton}"
                                    Content="Deinstallieren" MinWidth="140" Click="OnUninstallClick"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ===== Confirm overlay ===== -->
                <Border x:Name="ConfirmOverlay" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Background="{DynamicResource WindowBrush}"
                            Padding="22,20" Width="380"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="3" Opacity="0.25" Direction="270"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Style="{StaticResource BigIconTile}" Background="#E5484D" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource BigTileGlyph}"/>
                                </Border>
                                <TextBlock Text="Deinstallation bestätigen" Style="{StaticResource CardTitle}"
                                           FontSize="15" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Möchtest du SpeedScan Manager wirklich deinstallieren?"
                                       Style="{StaticResource CardText}" FontSize="13" Margin="0,0,0,18"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SecondaryButton}" Content="Abbrechen"
                                        Margin="0,0,8,0" Click="OnConfirmCancelClick"/>
                                <Button Style="{StaticResource DangerButton}" Content="Ja, deinstallieren"
                                        Click="OnConfirmUninstallClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

            <!-- ===== FOOTER ===== -->
            <Border Grid.Row="2" Background="{DynamicResource FooterBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Rectangle Fill="Transparent" MouseLeftButtonDown="OnDragMove"/>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="© 2026 VeridonNetzwerk" Style="{StaticResource FooterText}"/>
                        <TextBlock Text="·" Style="{StaticResource FooterText}" Margin="6,0"/>
                        <TextBlock Text="GPL-3.0 License" Style="{StaticResource FooterLink}"
                                   MouseLeftButtonDown="OnLicenseLinkClick"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0">
                        <TextBlock Text="Discord" Style="{StaticResource FooterLink}"
                                   Margin="0,0,16,0" MouseLeftButtonDown="OnDiscordLinkClick"/>
                        <TextBlock Text="GitHub" Style="{StaticResource FooterLink}"
                                   MouseLeftButtonDown="OnGitHubLinkClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
